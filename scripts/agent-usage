#!/usr/bin/env python3
"""Read local Codex, Claude and Antigravity usage limits and emit one normalized JSON snapshot.

Design notes
------------
Providers are read through the path their own tooling uses, so no
credential file is ever opened, copied, or transmitted by this script beyond
handing Claude Code's own OAuth access token back to Anthropic:

* Codex  - the documented app-server ``account/rateLimits/read`` method, run
           once per ``cxa`` profile with that profile's ``CODEX_HOME``.
* Claude - ``GET /api/oauth/usage``, the endpoint Claude Code's own ``/usage``
           command calls. When the cached token is expired or rejected we shell
           out to ``claude -p /usage`` which refreshes it, then retry once and
           fall back to parsing that command's text.

* Antigravity - agy's structured /usage report. The CLI owns sign-in and refresh;
                the collector reads no Google credentials.

Output is a small, versioned document so the Windows frame stays dumb.
"""

from __future__ import annotations

import argparse
import email.utils
import fcntl
import hashlib
from functools import lru_cache
import math
import concurrent.futures
from contextlib import closing
import datetime as dt
import json
import os
import re
import selectors
import sqlite3
import shutil
import subprocess
import sys
import time
import tempfile
import signal
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

SCHEMA_VERSION = 2
APP_VERSION = "2.0.0"
AUTH_STORE_OVERRIDE = 'cli_auth_credentials_store="file"'
ACCOUNT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
DEFAULT_CODEX_LABEL = "codex"

CLAUDE_USAGE_URL = os.environ.get(
    "AGENT_USAGE_CLAUDE_URL", "https://api.anthropic.com/api/oauth/usage?cedar_ember=1"
)
CLAUDE_BETA_HEADER = "oauth-2025-04-20"
MAX_RESPONSE_BYTES = 1024 * 1024

# Claude's API reports a limit's kind but not how long its window is.
CLAUDE_WINDOW_MINS = {
    "session": 300,
    "weekly": 10_080,
}


class UsageError(RuntimeError):
    pass


# ---------------------------------------------------------------- codex ----


def accounts_root() -> Path:
    configured = os.environ.get("CODEX_ACCOUNTS_DIR")
    if configured:
        return Path(configured).expanduser()
    xdg_data = os.environ.get("XDG_DATA_HOME")
    base = Path(xdg_data).expanduser() if xdg_data else Path.home() / ".local" / "share"
    return base / "codex-accounts"


def codex_profiles(requested: list[str] | None) -> list[tuple[str, Path]]:
    """Return one (label, CODEX_HOME) pair per Codex account to read.

    Multi-account setups keep a directory of profiles, each a CODEX_HOME of its
    own; a plain single-account install just has ~/.codex. Both are supported,
    and passing --codex-accounts with no names skips Codex entirely.
    """
    profiles_dir = accounts_root() / "profiles"
    if requested is not None:
        names = requested
    elif profiles_dir.is_dir():
        names = sorted(path.name for path in profiles_dir.iterdir() if path.is_dir())
    else:
        names = []

    if names:
        for name in names:
            if not ACCOUNT_RE.fullmatch(name):
                raise UsageError(f"Invalid account name: {name!r}")
            if not (profiles_dir / name).is_dir():
                raise UsageError(f"Account {name!r} does not exist under {profiles_dir}")
        return [(name, profiles_dir / name) for name in names]

    if requested is not None:
        return []

    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
    return [(DEFAULT_CODEX_LABEL, home)] if home.is_dir() else []


def active_codex_account() -> str | None:
    active_file = accounts_root() / "active"
    try:
        name = active_file.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return name if ACCOUNT_RE.fullmatch(name) else None


def _send(proc: subprocess.Popen[str], message: dict[str, Any]) -> None:
    if proc.stdin is None:
        raise UsageError("Codex app-server stdin is unavailable")
    proc.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
    proc.stdin.flush()


def _wait_for_response(
    proc: subprocess.Popen[str],
    selector: selectors.BaseSelector,
    request_id: int,
    timeout: float,
) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if proc.stdout is None:
            raise UsageError("Codex app-server stdout is unavailable")
        # A TextIOWrapper can prefetch several JSON lines, leaving select() with
        # no readable OS bytes even though the response is already buffered.
        # Keep framing on the raw descriptor; preserve surplus lines across RPCs.
        pending = getattr(proc, "_usage_pending", b"")
        while b"\n" not in pending:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not selector.select(remaining):
                raise UsageError(f"Timed out waiting for Codex response {request_id}")
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                raise UsageError(f"Codex app-server exited before responding (status {proc.poll()})")
            pending += chunk
            if len(pending) > 4 * 1024 * 1024:
                raise UsageError("Codex response is too large")
        line, proc._usage_pending = pending.split(b"\n", 1)
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("id") != request_id:
            continue
        if "error" in message:
            error = message["error"]
            detail = (
                error.get("message") or error.get("code") or "unknown error"
                if isinstance(error, dict)
                else str(error)
            )
            raise UsageError(f"Codex request failed: {detail}")
        result = message.get("result")
        if not isinstance(result, dict):
            raise UsageError("Codex returned an invalid response")
        return result


def query_codex(name: str, profile_home: Path, timeout: float) -> dict[str, Any]:
    binary = os.environ.get("CODEX_BIN") or shutil.which("codex")
    if not binary:
        return {"account": name, "error": "codex is not installed or not on PATH"}

    env = os.environ.copy()
    env["CODEX_HOME"] = str(profile_home)
    command = [binary, "-c", AUTH_STORE_OVERRIDE, "app-server", "--listen", "stdio://"]

    proc: subprocess.Popen[str] | None = None
    selector: selectors.BaseSelector | None = None
    try:
        proc = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
            env=env,
        )
        if proc.stdout is None:
            raise UsageError("Codex app-server stdout is unavailable")
        selector = selectors.DefaultSelector()
        selector.register(proc.stdout, selectors.EVENT_READ)

        _send(
            proc,
            {
                "method": "initialize",
                "id": 0,
                "params": {
                    "clientInfo": {
                        "name": "agent_usage",
                        "title": "Agent Usage",
                        "version": APP_VERSION,
                    }
                },
            },
        )
        _wait_for_response(proc, selector, 0, timeout)
        _send(proc, {"method": "initialized", "params": {}})
        _send(proc, {"method": "account/rateLimits/read", "id": 1})
        return {"account": name, "result": _wait_for_response(proc, selector, 1, timeout)}
    except (OSError, UsageError) as exc:
        return {"account": name, "error": str(exc)}
    finally:
        if selector is not None:
            selector.close()
        if proc is not None:
            if proc.stdin is not None:
                try:
                    proc.stdin.close()
                except OSError:
                    pass
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=2)


def _duration_label(minutes: Any) -> str | None:
    if not isinstance(minutes, int) or minutes <= 0:
        return None
    if minutes % 10_080 == 0:
        weeks = minutes // 10_080
        return "Weekly" if weeks == 1 else f"{weeks} weeks"
    if minutes % 1_440 == 0:
        days = minutes // 1_440
        return "Daily" if days == 1 else f"{days} days"
    if minutes % 60 == 0:
        hours = minutes // 60
        return "Hourly" if hours == 1 else f"{hours} hours"
    return f"{minutes} min"


def _percent(value: Any) -> int | None:
    try:
        return max(0, min(100, int(round(float(value)))))
    except (TypeError, ValueError):
        return None


def _limit(label: str, window: Any, fallback_mins: int | None = None) -> dict[str, Any] | None:
    if not isinstance(window, dict):
        return None
    used = _percent(window.get("usedPercent"))
    if used is None:
        return None
    minutes = window.get("windowDurationMins")
    if not isinstance(minutes, int) or minutes <= 0:
        minutes = fallback_mins
    resets_at = window.get("resetsAt")
    return {
        "label": _duration_label(minutes) or label,
        "usedPercent": used,
        "windowMins": minutes if isinstance(minutes, int) and minutes > 0 else None,
        "resetsAt": resets_at if isinstance(resets_at, int) else None,
    }


def normalize_codex(payload: dict[str, Any], active: str | None) -> dict[str, Any]:
    """Fold one raw app-server reply into the shared account shape."""
    name = str(payload.get("account", "?"))
    account: dict[str, Any] = {
        "id": f"codex:{name}",
        "provider": "codex",
        "label": name,
        "plan": None,
        "active": name == active,
        "error": payload.get("error"),
        "blocked": False,
        "limits": [],
        "resetCredits": None,
        "resetCreditDetails": None,
        "creditBalance": None,
        "extraUsage": None,
    }
    if account["error"]:
        return account

    result = payload.get("result") or {}
    buckets = result.get("rateLimitsByLimitId")
    if not isinstance(buckets, dict) or not buckets:
        snapshot = result.get("rateLimits")
        buckets = {"codex": snapshot} if isinstance(snapshot, dict) else {}

    for snapshot in buckets.values():
        if not isinstance(snapshot, dict):
            continue
        if not account["plan"]:
            plan = snapshot.get("planType")
            account["plan"] = str(plan) if plan else None
        if snapshot.get("rateLimitReachedType") or snapshot.get("spendControlReached"):
            account["blocked"] = True
        for label, key in (("5 hours", "primary"), ("Weekly", "secondary")):
            limit = _limit(label, snapshot.get(key))
            if limit:
                account["limits"].append(limit)
        credits = snapshot.get("credits")
        if isinstance(credits, dict) and account["creditBalance"] is None:
            if credits.get("unlimited"):
                account["creditBalance"] = -1.0
            else:
                try:
                    account["creditBalance"] = round(float(credits.get("balance", 0)), 2)
                except (TypeError, ValueError):
                    pass

    resets = result.get("rateLimitResetCredits")
    if isinstance(resets, dict):
        count = resets.get("availableCount")
        if isinstance(count, int):
            account["resetCredits"] = max(0, count)
        details = resets.get("credits")
        if isinstance(details, list):
            account["resetCreditDetails"] = []
            for credit in details:
                if not isinstance(credit, dict) or credit.get("status") != "available":
                    continue
                expires = credit.get("expiresAt")
                # Missing, non-expiring, and dated credits are different states.
                known = "expiresAt" in credit and (expires is None or
                    (type(expires) is int and 0 < expires <= 253402300799))
                account["resetCreditDetails"].append({
                    "expiresAt": expires if known else None,
                    "expirationKnown": known,
                })
            account["resetCreditDetails"].sort(key=lambda row:
                (row["expiresAt"] is None, row["expiresAt"] or 0))

    if not account["limits"]:
        account["error"] = "Codex returned no rate-limit windows."
    return account


# --------------------------------------------------------------- claude ----


def claude_config_dir() -> Path:
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    if configured:
        return Path(configured).expanduser()
    return Path.home() / ".claude"


def _claude_token() -> tuple[str | None, str | None, bool]:
    """Return (token, subscription, expired) from Claude Code's credential cache."""
    path = claude_config_dir() / ".credentials.json"
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None, None, False
    oauth = raw.get("claudeAiOauth")
    if not isinstance(oauth, dict):
        return None, None, False
    token = oauth.get("accessToken")
    subscription = oauth.get("subscriptionType")
    expires_at = oauth.get("expiresAt")
    expired = isinstance(expires_at, (int, float)) and expires_at / 1000 <= time.time() + 60
    if not isinstance(token, str) or not token:
        return None, subscription, expired
    return token, subscription, expired


def _cli_version(binary: str) -> tuple[int, ...] | None:
    try:
        result = subprocess.run([binary, "--version"], capture_output=True, text=True, timeout=3, check=True)
    except (OSError, subprocess.SubprocessError):
        return None
    found = re.search(r"\b(\d+)\.(\d+)\.(\d+)\b", result.stdout)
    return tuple(int(part) for part in found.groups()) if found else None


@lru_cache(maxsize=1)
def _claude_cli() -> tuple[str | None, tuple[int, ...] | None]:
    """The newest Claude Code on this host, and its version.

    PATH alone is not enough: over non-interactive SSH it lacks ~/.local/bin, where the native
    installer keeps the current build, and finds an old npm global in /usr/bin instead. The usage
    endpoint only returns resets to a current CLI, so the old one hid them. CLAUDE_BIN overrides.
    """
    if os.environ.get("CLAUDE_BIN"):
        binary = os.environ["CLAUDE_BIN"]
        return binary, _cli_version(binary)
    home = Path.home()
    candidates = [shutil.which("claude"), str(home / ".local" / "bin" / "claude"), str(home / ".claude" / "local" / "claude")]
    best: tuple[str | None, tuple[int, ...] | None] = (None, None)
    seen: set[str] = set()
    for binary in candidates:
        if not binary or not os.access(binary, os.X_OK) or os.path.realpath(binary) in seen:
            continue
        seen.add(os.path.realpath(binary))
        version = _cli_version(binary)
        if best[0] is None or (version is not None and (best[1] is None or version > best[1])):
            best = (binary, version)
    return best


def _claude_usage_user_agent() -> str:
    """Use the installed CLI version for the usage endpoint's surface check."""
    _, version = _claude_cli()
    if version:
        return f"claude-cli/{'.'.join(map(str, version))} (external, cli)"
    return f"agent-usage/{APP_VERSION}"


def _claude_fetch(token: str, timeout: float) -> dict[str, Any]:
    request = urllib.request.Request(
        CLAUDE_USAGE_URL,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": CLAUDE_BETA_HEADER,
            "Accept": "application/json",
            "User-Agent": _claude_usage_user_agent(),
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        body = response.read(MAX_RESPONSE_BYTES + 1)
    if len(body) > MAX_RESPONSE_BYTES:
        raise UsageError("Claude usage response was too large")
    parsed = json.loads(body.decode("utf-8"))
    if not isinstance(parsed, dict):
        raise UsageError("Claude usage response was not an object")
    return parsed


def _claude_cli_usage(timeout: float) -> str:
    """Run Claude Code's own /usage command, which also refreshes the token."""
    binary, _ = _claude_cli()
    if not binary:
        raise UsageError("claude is not installed or not on PATH")
    completed = subprocess.run(
        [binary, "-p", "/usage", "--output-format", "json", "--no-session-persistence"],
        capture_output=True,
        text=True,
        timeout=timeout,
        cwd=str(Path.home()),
    )
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip().splitlines()
        raise UsageError(detail[0] if detail else "claude /usage failed")
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise UsageError("claude /usage returned unreadable output") from exc
    text = payload.get("result")
    if not isinstance(text, str) or not text.strip():
        raise UsageError("claude /usage returned no usage text")
    return text


_USAGE_LINE_RE = re.compile(
    r"^Current (?:(session)|week \(([^)]*)\)):\s*(\d+)%\s*used"
    r"(?:\s*[·•-]\s*resets\s+(.+?))?\s*$"
)


def _parse_reset_text(text: str | None) -> int | None:
    """Turn 'Sep 8, 4am (America/New_York)' into a unix timestamp."""
    if not text:
        return None
    zone = None
    match = re.search(r"\(([^)]+)\)\s*$", text)
    if match:
        try:
            from zoneinfo import ZoneInfo

            zone = ZoneInfo(match.group(1))
        except Exception:
            zone = None
        text = text[: match.start()]
    stamp = text.strip().rstrip(".").upper()
    parsed = None
    for pattern in ("%b %d, %I:%M%p", "%b %d, %I%p", "%b %d, %H:%M"):
        try:
            parsed = dt.datetime.strptime(stamp, pattern)
            break
        except ValueError:
            continue
    if parsed is None:
        return None
    now = dt.datetime.now(tz=zone) if zone else dt.datetime.now().astimezone()
    best = None
    for year in (now.year - 1, now.year, now.year + 1):
        try:
            candidate = parsed.replace(year=year, tzinfo=now.tzinfo if zone is None else zone)
        except ValueError:
            continue
        delta = abs((candidate - now).total_seconds())
        if best is None or delta < best[0]:
            best = (delta, candidate)
    return int(best[1].timestamp()) if best else None


def parse_claude_usage_text(text: str) -> list[dict[str, Any]]:
    """Read the limit lines out of `claude -p /usage` output."""
    limits: list[dict[str, Any]] = []
    for line in text.splitlines():
        match = _USAGE_LINE_RE.match(line.strip())
        if not match:
            continue
        session, scope, percent, reset_text = match.groups()
        if session:
            label, minutes = "5 hours", CLAUDE_WINDOW_MINS["session"]
        else:
            scope = (scope or "").strip()
            minutes = CLAUDE_WINDOW_MINS["weekly"]
            label = "Weekly" if scope in ("", "all models") else f"Weekly {scope.replace(' only', '')}"
        limits.append(
            {
                "label": label,
                "usedPercent": _percent(percent) or 0,
                "windowMins": minutes,
                "resetsAt": _parse_reset_text(reset_text),
            }
        )
    return limits


_CLAUDE_LABELS = {
    "session": "5 hours",
    "weekly_all": "Weekly",
    "weekly_opus": "Weekly Opus",
    "weekly_sonnet": "Weekly Sonnet",
    "weekly_oauth_apps": "Weekly apps",
}


def _parse_iso(value: Any) -> int | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return int(dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


def normalize_claude_api(payload: dict[str, Any]) -> list[dict[str, Any]]:
    limits: list[dict[str, Any]] = []
    rows = payload.get("limits")
    if isinstance(rows, list) and rows:
        for row in rows:
            if not isinstance(row, dict):
                continue
            percent = _percent(row.get("percent"))
            if percent is None:
                continue
            kind = str(row.get("kind") or "")
            group = str(row.get("group") or "")
            limits.append(
                {
                    "label": _CLAUDE_LABELS.get(kind) or kind.replace("_", " ").capitalize() or "Limit",
                    "usedPercent": percent,
                    "windowMins": CLAUDE_WINDOW_MINS.get(group),
                    "resetsAt": _parse_iso(row.get("resets_at")),
                }
            )
        return limits

    for key, label, minutes in (
        ("five_hour", "5 hours", CLAUDE_WINDOW_MINS["session"]),
        ("seven_day", "Weekly", CLAUDE_WINDOW_MINS["weekly"]),
        ("seven_day_opus", "Weekly Opus", CLAUDE_WINDOW_MINS["weekly"]),
    ):
        row = payload.get(key)
        if not isinstance(row, dict):
            continue
        percent = _percent(row.get("utilization"))
        if percent is None:
            continue
        limits.append(
            {
                "label": label,
                "usedPercent": percent,
                "windowMins": minutes,
                "resetsAt": _parse_iso(row.get("resets_at")),
            }
        )
    return limits


def _claude_extra_usage(payload: dict[str, Any]) -> dict[str, Any] | None:
    extra = payload.get("extra_usage")
    if not isinstance(extra, dict):
        return None
    spend = payload.get("spend") if isinstance(payload.get("spend"), dict) else {}
    used = spend.get("used") if isinstance(spend.get("used"), dict) else {}
    amount = used.get("amount_minor")
    exponent = used.get("exponent")
    dollars = None
    if isinstance(amount, (int, float)) and isinstance(exponent, int):
        dollars = round(amount / (10**exponent), 2)
    return {
        "enabled": bool(extra.get("is_enabled")),
        "usedDollars": dollars,
        "reason": extra.get("disabled_reason"),
    }


def _claude_reset_credits(payload: dict[str, Any]) -> tuple[int | None, list[dict[str, Any]] | None]:
    """Project redeemable grants only, omitting their redemption handles."""
    block = payload.get("cedar_ember")
    if not isinstance(block, dict) or block.get("eligible") is not True or not isinstance(block.get("grants"), list):
        return None, None
    count, details = 0, []
    for grant in block["grants"]:
        if not isinstance(grant, dict) or grant.get("usable_now") is not True or grant.get("paused") is True:
            continue
        left = grant.get("resets_left")
        if type(left) is not int or left <= 0:
            continue
        expires = _parse_iso(grant.get("ends_at"))
        if expires is not None and expires <= time.time():
            continue
        count += left
        details.append({"expiresAt": expires, "expirationKnown": expires is not None, "count": left})
    return count, details


def _query_claude_uncached(timeout: float) -> dict[str, Any]:
    account: dict[str, Any] = {
        "id": "claude",
        "provider": "claude",
        "label": "Claude",
        "plan": None,
        "active": False,
        "error": None,
        "blocked": False,
        "limits": [],
        "resetCredits": None,
        "resetCreditDetails": None,
        "creditBalance": None,
        "extraUsage": None,
    }

    token, subscription, expired = _claude_token()
    account["plan"] = str(subscription) if subscription else None

    payload: dict[str, Any] | None = None
    fallback_text: str | None = None
    first_error: str | None = None

    if token and not expired:
        try:
            payload = _claude_fetch(token, timeout)
        except urllib.error.HTTPError as exc:
            if exc.code == 429:
                raise
            first_error = _short(exc)
        except (urllib.error.URLError, OSError, ValueError, UsageError) as exc:
            first_error = _short(exc)

    if payload is None:
        # Running Claude Code's own /usage refreshes an expired token and gives
        # us a readable answer even if the JSON endpoint has moved.
        try:
            fallback_text = _claude_cli_usage(max(timeout, 30.0))
        except (subprocess.SubprocessError, OSError, UsageError) as exc:
            account["error"] = first_error or _short(exc)
            return account
        token, subscription, _ = _claude_token()
        if subscription:
            account["plan"] = str(subscription)
        if token:
            try:
                payload = _claude_fetch(token, timeout)
            except urllib.error.HTTPError as exc:
                if exc.code == 429:
                    raise
                payload = None
            except (urllib.error.URLError, OSError, ValueError, UsageError):
                payload = None

    if payload is not None:
        account["limits"] = normalize_claude_api(payload)
        account["resetCredits"], account["resetCreditDetails"] = _claude_reset_credits(payload)
        account["extraUsage"] = _claude_extra_usage(payload)
    elif fallback_text:
        account["limits"] = parse_claude_usage_text(fallback_text)

    if not account["limits"]:
        account["error"] = first_error or "Claude returned no limits."
        return account

    account["blocked"] = any(limit["usedPercent"] >= 100 for limit in account["limits"])
    return account


def _retry_seconds(value: str | None, now: float) -> float:
    try:
        seconds = float(value or "0")
        return max(0.0, seconds) if math.isfinite(seconds) else 0.0
    except ValueError:
        try:
            return max(0.0, email.utils.parsedate_to_datetime(value).timestamp() - now)
        except (TypeError, ValueError, OverflowError):
            return 0.0


def query_claude(timeout: float) -> dict[str, Any]:
    """Share a credential-scoped cache/cooldown across polling processes.

    A 429 never launches the CLI fallback or immediately retries the endpoint.
    The file lock also prevents two frames on this host racing the same quota.
    Cache contains usage metadata only, never the token.
    """
    token, _, _ = _claude_token()
    identity = str(claude_config_dir().resolve()) + CLAUDE_USAGE_URL + (token or "signed-out")
    key = hashlib.sha256(identity.encode()).hexdigest()[:24]
    root = Path(os.environ.get("AGENT_USAGE_CACHE_DIR") or
                str(Path(os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")) / "agent-usage"))
    try:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = root / ("claude-" + key + ".json")
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return {"id": "claude", "provider": "claude", "label": "Claude", "limits": [],
                "error": "Cannot open usage cache; Claude polling paused."}
    with os.fdopen(fd, "r+", encoding="utf-8") as cache:
        fcntl.flock(cache, fcntl.LOCK_EX)
        try:
            saved = json.loads(cache.read(1024 * 1024))
            if not isinstance(saved, dict):
                saved = {}
        except (ValueError, OSError):
            saved = {}
        now = time.time()
        if isinstance(saved.get("nextAttempt"), (int, float)) and now < saved["nextAttempt"]:
            if isinstance(saved.get("account"), dict):
                return saved["account"]
        streak = min(8, max(0, int(saved.get("streak", 0))))
        try:
            account = _query_claude_uncached(timeout)
            streak = 0
            next_attempt = now + 300
            if not account.get("error"):
                account["sampledAt"] = int(time.time())
        except urllib.error.HTTPError as exc:
            if exc.code != 429:
                raise
            # Even Retry-After: 0 must not cause a hammering loop.
            delay = max(min(3600, 300 * (2 ** streak)),
                        _retry_seconds(exc.headers.get("Retry-After") if exc.headers else None, now))
            next_attempt = now + delay
            streak += 1
            previous = saved.get("account")
            account = dict(previous) if isinstance(previous, dict) else {
                "id": "claude", "provider": "claude", "label": "Claude", "limits": []}
            message = "Claude is rate limited; retry after " + dt.datetime.fromtimestamp(next_attempt).strftime("%H:%M")
            account["retryAt"] = int(next_attempt)
            account["stale"] = True
            if account.get("limits"):
                account["error"] = None
                account["warning"] = message + " (last reading)"
            else:
                account["error"] = message
        cache.seek(0)
        cache.truncate()
        json.dump({"account": account, "nextAttempt": next_attempt, "streak": streak}, cache)
        cache.flush()
        return account


def _short(value: Any) -> str:
    text = re.sub(r"\s+", " ", str(value)).strip()
    return text if len(text) <= 200 else text[:200] + "…"


# ------------------------------------------------------------- activity ----


def latest_activity(codex_homes: list[Path], include_claude: bool) -> int | None:
    """Newest local prompt across both CLIs, so the frame can poll adaptively.

    Both CLIs append to a history file on every prompt, so one stat per profile
    tells the frame whether anything is running without a network round trip.
    """
    candidates: list[Path] = []
    if include_claude:
        candidates.append(claude_config_dir() / "history.jsonl")
    candidates.extend(home / "history.jsonl" for home in codex_homes)

    newest: int | None = None
    for path in candidates:
        try:
            stamp = int(path.stat().st_mtime)
        except OSError:
            continue
        if newest is None or stamp > newest:
            newest = stamp
    return newest


# ------------------------------------------------------------- sessions ----
#
# Live "is it working?" state for the notch's session arcs, streamed by
# --watch-sessions. Only local files are read, never a credential:
#
# * Claude - Claude Code keeps <config>/sessions/<pid>.json up to date with
#            status busy | waiting | idle. The neighbouring *.key files hold
#            peer tokens and are never opened. A file whose process is gone,
#            or whose pid now belongs to another process, is left behind by a
#            crash and ignored.
# * Codex  - each turn appends task_started, then task_complete or
#            turn_aborted, to the session's rollout. Codex does not record
#            approval waits there. Question tool calls stay waiting until their
#            answer arrives, even while an async question allows work to continue.
#            Terminal states support completion alerts.
#            Sub-agents (the guardian that reviews an approval, spawned helpers) keep rollouts of their own
#            whose short tasks start and finish while their parent is still working; they are part of the
#            parent's turn, never sessions of their own, or each review would read as "finished".
# * AGY    - locked CLI presence plus its read-only summary database. Pending
#            transcript steps distinguish explicit questions/permission waits.

SESSION_POLL_SECONDS = 1.5
SESSION_HEARTBEAT_SECONDS = 15.0
CODEX_QUIET_SECONDS = 30 * 60  # a busy rollout this quiet is a turn that died without closing
SESSION_TAIL_BYTES = 256 * 1024
CLAUDE_STATES = {"busy": "busy", "waiting": "waiting", "idle": "idle"}
CODEX_TURN_EVENTS = {"task_started": "busy", "task_complete": "idle", "turn_aborted": "canceled"}


def _process_matches(pid: Any, proc_start: Any) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    if proc_start is None:
        return True
    # Field 22 is the start time; the name in field 2 may contain spaces, so count from its ")"
    fields = stat[stat.rfind(")") + 2 :].split()
    return len(fields) > 19 and fields[19] == str(proc_start)


def process_ancestry(pid: Any, proc_root: Path = Path("/proc")) -> list[int]:
    """Only process ids/parent ids, to locate an existing VS Code terminal; never read its environment."""
    chain: list[int] = []
    while isinstance(pid, int) and pid > 1 and pid not in chain and len(chain) < 16:
        try:
            stat = (proc_root / str(pid) / "stat").read_text()
            fields = stat[stat.rfind(")") + 2:].split()
            parent = int(fields[1])
        except (OSError, ValueError, IndexError):
            break
        chain.append(pid)
        pid = parent
    return chain


_rollout_process_cache: tuple[float, dict[str, list[int]]] = (0, {})


def rollout_processes(proc_root: Path = Path("/proc")) -> dict[str, list[int]]:
    global _rollout_process_cache
    now = time.monotonic()
    if proc_root == Path("/proc") and now - _rollout_process_cache[0] < 5:
        return _rollout_process_cache[1]
    found: dict[str, list[int]] = {}
    for process in proc_root.iterdir():
        if not process.name.isdigit():
            continue
        try:
            executable = (process / "exe").resolve().name
            if not (executable.startswith("codex") or executable == "agy"):
                continue
            for fd in (process / "fd").iterdir():
                try:
                    target = fd.resolve()
                    if (target.name.startswith("rollout-") and target.suffix == ".jsonl") or (executable == "agy" and target.parent.name == "presence" and target.suffix == ".lock"):
                        found[str(target)] = process_ancestry(int(process.name), proc_root)
                except OSError:
                    continue
        except OSError:
            continue
    if proc_root == Path("/proc"):
        _rollout_process_cache = (now, found)
    return found


def claude_sessions(config_dir: Path, include_terminal: bool = False) -> list[dict[str, Any]]:
    sessions: list[dict[str, Any]] = []
    for path in sorted((config_dir / "sessions").glob("*.json"))[:64]:
        try:
            if path.stat().st_size > 64 * 1024:
                continue
            record = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(record, dict):
            continue
        state = CLAUDE_STATES.get(record.get("status"))
        if state is None or (state == "idle" and not include_terminal) or not _process_matches(record.get("pid"), record.get("procStart")):
            continue
        since = record.get("statusUpdatedAt")
        waiting_for = record.get("waitingFor")
        sessions.append({
            "provider": "claude",
            "account": "claude",
            "id": _short(record.get("sessionId") or path.stem),
            "sessionId": _short(record.get("sessionId") or ""),
            "terminalPids": process_ancestry(record.get("pid")),
            "cwd": record.get("cwd") if isinstance(record.get("cwd"), str) else None,
            "name": _short(record.get("name") or Path(str(record.get("cwd") or "Claude")).name),
            "state": state,
            "waitingFor": _short(waiting_for) if state == "waiting" and isinstance(waiting_for, str) else None,
            "since": int(since / 1000) if isinstance(since, (int, float)) else None,
        })
    return sessions


# What each rollout last said about its turn and how far it has been read. A long turn writes megabytes after its
# task_started (every tool output goes into the rollout), far past any fixed tail: a session read only from the tail
# fell out of view mid-turn, came back finished with no "was working" before it, and its end was never announced.
# Cache: inode, observed size, complete-line offset, session state, pending call ids (async or sync).
_codex_turns: dict[str, tuple[int, int, int, tuple[str | None, int | None, str | None], dict[str, bool]]] = {}


def _latest_turn_event(chunk: bytes) -> tuple[str, int | None] | None:
    for line in reversed(chunk.splitlines()):
        if b'"event_msg"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue  # a line cut by the window, or one still being written
        payload = entry.get("payload") if isinstance(entry, dict) else None
        kind = payload.get("type") if isinstance(payload, dict) else None
        if kind in CODEX_TURN_EVENTS:
            return CODEX_TURN_EVENTS[kind], _parse_iso(entry.get("timestamp"))
    return None


def _codex_question_state(chunk: bytes, state: str | None = None, since: int | None = None,
                          pending: dict[str, bool] | None = None) -> tuple[str | None, int | None, dict[str, bool]]:
    """Track question call identities only; never export prompts or user answers."""
    pending = dict(pending or {})
    if state == "waiting":
        state = "busy"  # The underlying turn is still running.
    for line in chunk.splitlines():
        # Ignore usage records and other non-rollout data.
        if b'"event_msg"' not in line and b'"response_item"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        payload = entry.get("payload") if isinstance(entry, dict) else None
        if not isinstance(payload, dict):
            continue
        kind = payload.get("type")
        if entry.get("type") == "event_msg":
            if kind in CODEX_TURN_EVENTS:
                state, since = CODEX_TURN_EVENTS[kind], _parse_iso(entry.get("timestamp"))
                pending.clear()
            elif kind == "user_message":
                pending.clear()
        elif entry.get("type") == "response_item":
            if kind == "message" and payload.get("role") == "user":
                pending.clear()
            call_id = payload.get("call_id")
            if not isinstance(call_id, str):
                continue
            if kind == "function_call" and state == "busy":
                name = payload.get("name")
                if name in {"request_user_input", "functions.request_user_input", "request_user_input_async", "functions.request_user_input_async"}:
                    pending[call_id] = name.endswith("_async")
            elif kind == "function_call_output" and call_id in pending:
                output = payload.get("output")
                try:
                    output = json.loads(output) if isinstance(output, str) else output
                except ValueError:
                    pass
                # The async tool acknowledges displaying the prompt immediately;
                # that acknowledgment is not the user's answer.
                if not (pending[call_id] and output == {"accepted": True}):
                    pending.pop(call_id)
    return ("waiting" if state == "busy" and pending else state), since, pending


def _codex_turn_state(path: Path) -> tuple[str | None, int | None, str | None]:
    """Return (state, turn start, cwd) for one rollout; a sub-agent's rollout has no state of its own.

    The first look reads back from the end, widening until it finds the turn; after that only what has been
    written since is read. Incomplete final lines are reread once they are complete."""
    stat = path.stat()
    key, size = str(path), stat.st_size
    known = _codex_turns.get(key)
    if known and known[0] == stat.st_ino and known[1] == size:
        return known[3]
    with path.open("rb") as handle:
        first = handle.readline(64 * 1024)
        cwd = None
        try:
            meta = json.loads(first)
            if meta.get("type") == "session_meta" and isinstance(meta.get("payload"), dict):
                payload = meta["payload"]
                source = payload.get("source")
                if (isinstance(source, dict) and "subagent" in source) or payload.get("parent_thread_id"):
                    _codex_turns[key] = (stat.st_ino, size, size, (None, None, None), {})
                    return None, None, None
                cwd = payload.get("cwd")
        except ValueError:
            pass
        cwd = cwd if isinstance(cwd, str) else None
        if known and known[0] == stat.st_ino and known[1] < size:
            offset = known[2]
            handle.seek(offset)
            chunk = handle.read(size - offset)
            complete = chunk[:chunk.rfind(b"\n") + 1]
            state, started, pending = _codex_question_state(complete, known[3][0], known[3][1], known[4])
        else:
            found, window = None, SESSION_TAIL_BYTES
            while True:
                offset = max(0, size - window)
                handle.seek(offset)
                chunk = handle.read(min(size, window))
                complete = chunk[:chunk.rfind(b"\n") + 1]
                found = _latest_turn_event(complete)
                if found or window >= size or window >= 64 * 1024 * 1024:
                    break
                window *= 4
            state, started, pending = _codex_question_state(complete)
        result = (state, started, cwd)
    if len(_codex_turns) > 512:
        _codex_turns.clear()
    _codex_turns[key] = (stat.st_ino, size, offset + len(complete), result, pending)
    return result


def codex_sessions(profiles: list[tuple[str, Path]], now: float, include_terminal: bool = False) -> list[dict[str, Any]]:
    sessions: list[dict[str, Any]] = []
    seen: set[Path] = set()
    processes = rollout_processes()
    days = {dt.datetime.fromtimestamp(now - offset).strftime("%Y/%m/%d") for offset in (0, 86400)}
    for name, home in profiles:
        for day in sorted(days):
            for path in sorted((home / "sessions" / day).glob("rollout-*.jsonl")):
                try:
                    real = path.resolve()
                    if real in seen or now - path.stat().st_mtime > CODEX_QUIET_SECONDS:
                        continue
                    seen.add(real)
                    state, started, cwd = _codex_turn_state(path)
                except OSError:
                    continue
                if state is None or (state not in {"busy", "waiting"} and not include_terminal):
                    continue
                sessions.append({
                    "provider": "codex",
                    "account": f"codex:{name}",
                    "id": _short(path.stem),
                    "sessionId": path.stem[-36:] if re.fullmatch(r"[0-9a-fA-F-]{36}", path.stem[-36:]) else None,
                    "terminalPids": processes.get(str(real), []),
                    "cwd": cwd,
                    "name": _short(Path(cwd).name if cwd else "Codex"),
                    "state": state,
                    "waitingFor": "input needed" if state == "waiting" else None,
                    "since": started,
                })
    return sessions


def antigravity_sessions(data_dir: Path, include_terminal: bool = False) -> list[dict[str, Any]]:
    """Read live CLI presence and status metadata; never open Google credentials."""
    database = data_dir / "conversation_summaries.db"
    if not database.is_file():
        return []
    sessions: list[dict[str, Any]] = []
    try:
        with closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=.1)) as conn:
            records = conn.execute("SELECT conversation_id, title, status, not_fully_idle, killed, last_modified_time FROM conversation_summaries ORDER BY last_modified_time DESC LIMIT 64").fetchall()
        processes = rollout_processes() if include_terminal else {}
        for identity, title, status, background, killed, modified in records:
            if killed or not re.fullmatch(r"[a-zA-Z0-9_-]{1,100}", identity or ""):
                continue
            try:
                with (data_dir / "presence" / (identity + ".lock")).open("rb") as lock:
                    try:
                        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        pass  # The CLI still owns this conversation.
                    else:
                        continue
            except OSError:
                continue
            active = status in {"CASCADE_RUN_STATUS_RUNNING", "CASCADE_RUN_STATUS_BUSY"} or (status == "CASCADE_RUN_STATUS_IDLE" and background)
            waiting = status == "CASCADE_RUN_STATUS_WAITING"
            if not active and not waiting and status != "CASCADE_RUN_STATUS_IDLE":
                continue
            state, reason = ("waiting", "input needed") if waiting else (("busy" if active else "idle"), None)
            transcript = data_dir / "brain" / identity / ".system_generated" / "logs" / "transcript.jsonl"
            try:
                with transcript.open("rb") as handle:
                    handle.seek(max(0, transcript.stat().st_size - SESSION_TAIL_BYTES))
                    lines = handle.read().splitlines()
                for line in reversed(lines):
                    try:
                        step = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(step, dict):
                        continue
                    calls = step.get("tool_calls")
                    question = isinstance(calls, list) and any(isinstance(call, dict) and call.get("name") in {"ask_question", "ask_permission"} for call in calls)
                    # AGY can mark the conversation idle while a question is still
                    # pending. Inspect input requests before treating idle as a
                    # completed turn, including in the activity-only feed.
                    if step.get("status") == "WAITING" or question:
                        state, reason = "waiting", "input needed"
                    break
            except OSError:
                pass
            if state == "idle" and not include_terminal:
                continue
            sessions.append({"provider": "antigravity", "account": "antigravity", "id": identity,
                             **({"sessionId": identity, "terminalPids": processes.get(str((data_dir / "presence" / (identity + ".lock")).resolve()), [])} if include_terminal else {}),
                             "name": _short(title or "Antigravity"), "state": state,
                             "waitingFor": reason, "since": _parse_iso(modified) if isinstance(modified, str) else None})
    except (OSError, sqlite3.Error):
        return []
    return sessions


def session_links(profiles: list[tuple[str, Path]], config_dir: Path, now: float) -> list[dict[str, Any]]:
    """Bounded, read-only completion metadata for restoring pre-link alerts; never send message bodies."""
    sessions = claude_sessions(config_dir, include_terminal=True)
    processes = rollout_processes()
    days = {dt.datetime.fromtimestamp(now - offset * 86400).strftime("%Y/%m/%d") for offset in range(8)}
    seen: set[Path] = set()
    for name, home in profiles:
        paths = sorted((p for day in days for p in (home / "sessions" / day).glob("rollout-*.jsonl")), reverse=True)[:512]
        for path in paths:
            try:
                real = path.resolve()
                if real in seen:
                    continue
                seen.add(real)
                with path.open("rb") as handle:
                    meta = json.loads(handle.readline(64 * 1024))
                    payload = meta.get("payload") or {}
                    source = payload.get("source")
                    if meta.get("type") != "session_meta" or (isinstance(source, dict) and "subagent" in source) or payload.get("parent_thread_id"):
                        continue
                    identity = payload.get("id") or path.stem[-36:]
                    if not isinstance(identity, str) or not re.fullmatch(r"[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}", identity):
                        continue
                    handle.seek(max(handle.tell(), path.stat().st_size - SESSION_TAIL_BYTES))
                    lines = handle.read(SESSION_TAIL_BYTES).splitlines()
                for line in lines:
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    if event.get("type") != "event_msg" or (event.get("payload") or {}).get("type") != "task_complete":
                        continue
                    ended = _parse_iso(event.get("timestamp"))
                    if ended is None or ended < now - 7 * 86400:
                        continue
                    sessions.append({"provider": "codex", "account": f"codex:{name}", "id": identity, "sessionId": identity,
                                     "name": _short(Path(payload.get("cwd") or "Codex").name), "state": "idle", "since": ended,
                                     **({"terminalPids": processes[str(real)], "cwd": payload.get("cwd")} if processes.get(str(real)) else {})})
            except (OSError, ValueError, AttributeError, TypeError):
                continue
    return sessions[-2048:]


def _claude_usage_probe(records: list[dict[str, Any]]) -> bool:
    """Recognize only SDK /usage-only transcripts; retain interactive and substantive chats."""
    users = [r for r in records if r.get("type") == "user" and not r.get("isMeta")]
    if not users or any(r.get("type") in {"assistant", "custom-title", "ai-title", "aiTitle", "summary"} for r in records):
        return False
    command = re.compile(r"\s*<command-name>/usage</command-name>\s*<command-message>usage</command-message>\s*<command-args>\s*</command-args>\s*")
    for record in users:
        message = record.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        if record.get("entrypoint") != "sdk-cli" or record.get("userType") != "external" or not isinstance(content, str):
            return False
        if content.strip() != "/usage" and not command.fullmatch(content):
            return False
    return True


def session_history(profiles: list[tuple[str, Path]], config_dir: Path, now: float,
                    include_claude: bool = True, include_antigravity: bool = True) -> list[dict[str, Any]]:
    """Recent saved conversations, including closed ones. Export names/identity only, never messages."""
    limit = 30
    uuid = re.compile(r"[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}")
    live = (claude_sessions(config_dir, True) if include_claude else []) + codex_sessions(profiles, now, True)
    live_by_id = {(s["account"], s.get("sessionId")): s for s in live}
    history: list[dict[str, Any]] = []
    seen: set[Path] = set()

    def recent(root: Path, pattern: str) -> list[Path]:
        candidates = []
        for i, path in enumerate(root.glob(pattern)):
            if i >= 10000:
                break
            try:
                candidates.append((path.stat().st_mtime, path))
            except OSError:
                continue
        return [p for _, p in sorted(candidates, reverse=True)[:256]]

    def edges(path: Path) -> list[dict[str, Any]]:
        with path.open("rb") as handle:
            head = handle.read(64 * 1024)
            start = max(0, path.stat().st_size - 64 * 1024)
            handle.seek(start)
            tail = handle.read(64 * 1024)
        records = []
        for line in head.splitlines() + (tail.splitlines()[1:] if start else []):
            try:
                record = json.loads(line)
                if isinstance(record, dict):
                    records.append(record)
            except (ValueError, UnicodeDecodeError):
                continue
        return records

    for provider, account, home, paths in (
        [("claude", "claude", config_dir, recent(config_dir / "projects", "*/*.jsonl"))] if include_claude else []
    ) + [("codex", f"codex:{name}", home, recent(home / "sessions", "*/*/*/rollout-*.jsonl")) for name, home in profiles]:
        titles = {}
        if provider == "codex":
            # The CLI's index is append-only. Read a bounded tail for the latest saved names.
            try:
                for record in edges(home / "session_index.jsonl"):
                    titles[record.get("id")] = record.get("thread_name")
            except OSError:
                pass
        count = 0
        for path in paths:
            if count >= limit:
                break
            try:
                real = path.resolve()
                if real in seen:
                    continue
                records = edges(path)
                # Only classify complete small transcripts, never a head/tail excerpt of a real chat.
                if provider == "claude" and path.stat().st_size <= 64 * 1024 and _claude_usage_probe(records):
                    continue
                if provider == "codex":
                    meta = next((r.get("payload") or {} for r in records if r.get("type") == "session_meta"), {})
                    source = meta.get("source")
                    if (isinstance(source, dict) and "subagent" in source) or meta.get("parent_thread_id"):
                        continue
                    identity, cwd = meta.get("id") or path.stem[-36:], meta.get("cwd")
                    title = titles.get(identity) or meta.get("title")
                else:
                    identity = path.stem
                    cwd = next((r["cwd"] for r in records if isinstance(r.get("cwd"), str)), None)
                    title = next((r.get("customTitle") for r in reversed(records)
                                  if r.get("type") == "custom-title" and isinstance(r.get("customTitle"), str) and r["customTitle"].strip()), None)
                    if not title:
                        title = next((r.get("aiTitle") or r.get("summary") for r in reversed(records)
                                      if r.get("type") in {"ai-title", "aiTitle", "summary"}
                                      and isinstance(r.get("aiTitle") or r.get("summary"), str)
                                      and (r.get("aiTitle") or r.get("summary")).strip()), None)
                if not isinstance(identity, str) or not uuid.fullmatch(identity):
                    continue
                seen.add(real)
                current = live_by_id.get((account, identity), {})
                cwd = current.get("cwd") or cwd
                history.append({"provider": provider, "account": account, "id": identity, "sessionId": identity,
                                "name": _short(title or current.get("name") or Path(cwd or provider.title()).name),
                                "state": current.get("state", "idle"), "since": path.stat().st_mtime,
                                "cwd": cwd, "agentHome": str(home.absolute()),
                                "terminalPids": current.get("terminalPids", []), "live": bool(current)})
                count += 1
            except (OSError, ValueError, TypeError, AttributeError):
                continue
    if include_antigravity:
        database = Path.home() / ".gemini" / "antigravity-cli" / "conversation_summaries.db"
        if database.is_file():
            try:
                with closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=.1)) as conn:
                    rows = conn.execute("SELECT conversation_id, title, last_modified_time, workspace_uris FROM conversation_summaries WHERE parent_conversation_id = '' AND app_data_dir = 'antigravity-cli' ORDER BY last_modified_time DESC LIMIT 30").fetchall()
                agy_live = {s["id"]: s for s in antigravity_sessions(database.parent, True)}
                for identity, title, modified, workspaces in rows:
                    if isinstance(identity, str) and uuid.fullmatch(identity):
                        try:
                            uris = json.loads(workspaces)
                            if not isinstance(uris, list):
                                continue
                        except (ValueError, TypeError):
                            continue
                        workspace = next((urllib.parse.urlparse(u) for u in uris if isinstance(u, str) and u.startswith("file:///")), None)
                        current = agy_live.get(identity, {})
                        history.append({"provider": "antigravity", "account": "antigravity", "id": identity, "sessionId": identity,
                                        "name": _short(title or "Antigravity"), "state": current.get("state", "idle"), "since": _parse_iso(modified) or 0,
                                        "cwd": urllib.parse.unquote(workspace.path) if workspace else None,
                                        "agentHome": str(database.parent), "live": bool(current), "terminalPids": current.get("terminalPids", [])})
            except (OSError, sqlite3.Error, ValueError, TypeError):
                pass
    return sorted(history, key=lambda s: s["since"], reverse=True)


def watch_sessions(profiles: list[tuple[str, Path]], include_claude: bool, include_antigravity: bool = True) -> int:
    """Print one JSON line per change, and at least every heartbeat, until the reader goes away."""
    last_sent, last_line = 0.0, ""
    while True:
        now = time.time()
        sessions = (claude_sessions(claude_config_dir(), include_terminal=True) if include_claude else []) + codex_sessions(profiles, now, include_terminal=True)
        if include_antigravity:
            sessions += antigravity_sessions(Path.home() / ".gemini" / "antigravity-cli", include_terminal=True)
        sessions.sort(key=lambda s: (s["state"] not in {"busy", "waiting"}, s["provider"], s["account"], s["id"]))
        line = json.dumps({"schema": 1, "sessions": sessions[:40]}, separators=(",", ":"))
        if line != last_line or now - last_sent >= SESSION_HEARTBEAT_SECONDS:
            try:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            except (BrokenPipeError, ValueError):
                # The SSH or WSL session that asked has ended; point stdout at nothing so the
                # interpreter's own flush on the way out does not report the broken pipe again
                os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
                return 0
            last_sent, last_line = now, line
        time.sleep(SESSION_POLL_SECONDS)


# ----------------------------------------------------------------- main ----


def normalize_antigravity(report: dict[str, Any]) -> dict[str, Any]:
    """Accept measured buckets from agy's usage command, never model availability."""
    if not isinstance(report, dict):
        raise UsageError("Antigravity returned an invalid usage report.")
    command = report.get("command")
    if not isinstance(command, dict):
        raise UsageError("Antigravity returned an invalid usage report.")
    if report.get("status") != "SUCCESS" or command.get("name") != "usage":
        raise UsageError("Antigravity usage unavailable; check agy sign-in.")
    limits = []
    data = command.get("data")
    if not isinstance(data, dict) or not isinstance(data.get("groups"), list):
        raise UsageError("Antigravity did not report measured usage limits.")
    for group in data["groups"][:20]:
        if not isinstance(group, dict):
            continue
        buckets = group.get("buckets", [])
        if not isinstance(buckets, list):
            continue
        for bucket in buckets[:20]:
            if not isinstance(bucket, dict) or bucket.get("enabled") is False:
                continue
            remaining = bucket.get("remaining_fraction")
            if isinstance(remaining, bool) or not isinstance(remaining, (int, float)) or not math.isfinite(remaining) or not 0 <= remaining <= 1:
                continue
            window = bucket.get("window")
            minutes = {"weekly": 10080, "5h": 300}.get(window)
            if minutes is None:
                continue
            limits.append({"id": str(bucket.get("id") or f"agy-{len(limits)}"),
                "label": "Weekly" if window == "weekly" else "Five hour",
                "group": str(group.get("name") or "Models"),
                "usedPercent": round((1 - remaining) * 100, 4), "windowMins": minutes,
                "resetsAt": _parse_iso(bucket.get("reset_time"))})
    if not limits:
        raise UsageError("Antigravity did not report measured usage limits.")
    return {"id": "antigravity", "provider": "antigravity", "label": "Antigravity",
        "sampledAt": int(time.time()), "limits": limits}


def antigravity_executable() -> str | None:
    """SSH commands often omit ~/.local/bin even though the CLI is installed there."""
    found = shutil.which("agy")
    if found:
        return found
    local = Path.home() / ".local" / "bin" / "agy"
    return str(local) if local.is_file() and os.access(local, os.X_OK) else None


def query_antigravity(timeout: float) -> dict[str, Any]:
    account = {"id": "antigravity", "provider": "antigravity", "label": "Antigravity", "limits": []}
    executable = antigravity_executable()
    try:
        if not executable:
            raise UsageError("Install and sign into agy on the collector machine.")
        version = subprocess.run([executable, "--version"], stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, timeout=min(timeout, 3), check=True).stdout
        match = re.search(r"(\d+)\.(\d+)\.(\d+)", version)
        if not match or tuple(map(int, match.groups())) < (1, 1, 11):
            raise UsageError("Update agy to use structured usage reports.")
        # A private empty directory avoids project prompts and project-specific configuration.
        with tempfile.TemporaryDirectory(prefix="agent-usage-agy-") as work, tempfile.TemporaryFile() as output:
            proc = subprocess.Popen([executable, "-p", "/usage", "--output-format", "json"],
                cwd=work, stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.DEVNULL,
                start_new_session=True)
            try:
                proc.wait(timeout=timeout)
                if proc.returncode:
                    raise UsageError("Antigravity usage unavailable; check agy sign-in and connection.")
                output.seek(0)
                raw = output.read(MAX_RESPONSE_BYTES + 1)
                if len(raw) > MAX_RESPONSE_BYTES:
                    raise UsageError("Antigravity usage report exceeded the size limit.")
                return normalize_antigravity(json.loads(raw))
            finally:
                # Only signal the process group created for this read, never an existing agy.
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                if proc.poll() is None:
                    try:
                        proc.wait(timeout=1)
                    except subprocess.TimeoutExpired:
                        os.killpg(proc.pid, signal.SIGKILL)
                        proc.wait()
    except UsageError as exc:
        account["error"] = str(exc)
    except subprocess.TimeoutExpired:
        account["error"] = "Antigravity usage timed out."
    except (OSError, ValueError, TypeError, subprocess.CalledProcessError):
        account["error"] = "Antigravity usage could not be read."
    return account


def collect(
    profiles: list[tuple[str, Path]], include_claude: bool, timeout: float, include_antigravity: bool = False
) -> dict[str, Any]:
    active = active_codex_account()
    accounts: list[dict[str, Any]] = []

    jobs = len(profiles) + int(include_claude) + int(include_antigravity)
    if jobs:
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(jobs, 4)) as pool:
            codex_futures = [
                pool.submit(query_codex, name, home, timeout) for name, home in profiles
            ]
            claude_future = pool.submit(query_claude, timeout) if include_claude else None
            agy_future = pool.submit(query_antigravity, timeout) if include_antigravity else None
            for future in codex_futures:
                accounts.append(normalize_codex(future.result(), active))
            if claude_future is not None:
                accounts.append(claude_future.result())
            if agy_future is not None:
                accounts.append(agy_future.result())

    return {
        "schema": SCHEMA_VERSION,
        "generatedAt": int(time.time()),
        "activityAt": latest_activity([home for _, home in profiles], include_claude),
        "accounts": accounts,
    }


def self_test() -> bool:
    codex_fixture = {
        "account": "a",
        "result": {
            "rateLimits": {
                "planType": "plus",
                "primary": {"usedPercent": 62, "windowDurationMins": 300, "resetsAt": 1788853701},
                "secondary": {"usedPercent": 30, "windowDurationMins": 10080, "resetsAt": 1789400570},
                "credits": {"hasCredits": True, "unlimited": False, "balance": "1294.1415"},
                "rateLimitReachedType": None,
            },
            "rateLimitsByLimitId": None,
            "rateLimitResetCredits": {"availableCount": 3},
        },
    }
    codex = normalize_codex(codex_fixture, "a")
    checks = [
        codex["plan"] == "plus",
        codex["active"] is True,
        codex["blocked"] is False,
        codex["resetCredits"] == 3,
        codex["creditBalance"] == 1294.14,
        [limit["label"] for limit in codex["limits"]] == ["5 hours", "Weekly"],
        codex["limits"][0]["usedPercent"] == 62,
        codex["limits"][1]["windowMins"] == 10080,
    ]

    blocked = normalize_codex(
        {
            "account": "b",
            "result": {
                "rateLimits": {
                    "planType": "plus",
                    "primary": {"usedPercent": 100, "windowDurationMins": 300, "resetsAt": 1},
                    "rateLimitReachedType": "rate_limit_reached",
                }
            },
        },
        "a",
    )
    checks += [blocked["blocked"] is True, blocked["active"] is False]

    checks.append(normalize_codex({"account": "c", "error": "boom"}, None)["error"] == "boom")

    api = normalize_claude_api(
        {
            "limits": [
                {"kind": "session", "group": "session", "percent": 6, "resets_at": "2026-09-08T08:00:00+00:00"},
                {"kind": "weekly_all", "group": "weekly", "percent": 20, "resets_at": "2026-09-08T04:00:00+00:00"},
            ]
        }
    )
    checks += [
        [limit["label"] for limit in api] == ["5 hours", "Weekly"],
        api[0]["windowMins"] == 300,
        api[1]["resetsAt"] == 1788840000,
    ]

    legacy = normalize_claude_api(
        {"five_hour": {"utilization": 6.0, "resets_at": "2026-09-08T08:00:00+00:00"}, "limits": []}
    )
    checks.append(len(legacy) == 1 and legacy[0]["usedPercent"] == 6)

    text = parse_claude_usage_text(
        "You are currently using your subscription\n"
        "Current session: 5% used · resets Sep 8, 4am (America/New_York)\n"
        "Current week (all models): 20% used · resets Sep 8, 12:30am (America/New_York)\n"
        "Current week (Sonnet only): 3% used\n"
    )
    checks += [
        [limit["label"] for limit in text] == ["5 hours", "Weekly", "Weekly Sonnet"],
        text[0]["usedPercent"] == 5,
        text[1]["windowMins"] == 10080,
        isinstance(text[0]["resetsAt"], int),
        text[2]["resetsAt"] is None,
    ]

    failures = [index for index, ok in enumerate(checks) if not ok]
    if failures:
        print(f"self-test failed at checks {failures}", file=sys.stderr)
    return not failures


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Emit one normalized JSON snapshot of Codex, Claude and Antigravity usage limits."
    )
    parser.add_argument(
        "--codex-accounts",
        nargs="*",
        metavar="NAME",
        help="Codex profiles to read (default: all of them; pass with no names to skip Codex)",
    )
    parser.add_argument("--no-antigravity", action="store_true", help="skip automatic agy usage discovery")
    parser.add_argument("--no-claude", action="store_true", help="skip the Claude account")
    parser.add_argument("--timeout", type=float, default=20.0, help="per-provider timeout")
    parser.add_argument("--compact", action="store_true", help="emit JSON without indentation")
    parser.add_argument("--self-test", action="store_true", help="check the parsers and exit")
    parser.add_argument(
        "--watch-sessions",
        action="store_true",
        help="stream live session state as JSON lines instead of reading usage",
    )
    parser.add_argument("--session-links", action="store_true", help="read recent completion metadata for historical alert links")
    parser.add_argument("--session-history", action="store_true", help="list the 30 most recent saved sessions per account")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv if argv is not None else sys.argv[1:])
    if args.self_test:
        return 0 if self_test() else 1
    try:
        if args.timeout <= 0:
            raise UsageError("--timeout must be greater than zero")
        profiles = codex_profiles(args.codex_accounts)
        if args.session_links:
            document = {"schema": 1, "sessions": session_links(profiles, claude_config_dir(), time.time())}
            json.dump(document, sys.stdout, separators=(",", ":")); sys.stdout.write("\n")
            return 0
        include_claude = not args.no_claude
        include_antigravity = not args.no_antigravity and bool(antigravity_executable())
        if args.session_history:
            document = {"schema": 1, "sessions": session_history(profiles, claude_config_dir(), time.time(), include_claude, include_antigravity),
                        "wslDistro": os.environ.get("WSL_DISTRO_NAME", "")}
            json.dump(document, sys.stdout, separators=(",", ":")); sys.stdout.write("\n")
            return 0
        if not profiles and not include_claude and not include_antigravity:
            raise UsageError("Nothing to read: no Codex accounts and Claude is disabled.")
        if args.watch_sessions:
            try:
                return watch_sessions(profiles, include_claude, include_antigravity)
            except KeyboardInterrupt:
                return 0
        document = collect(profiles, include_claude, args.timeout, include_antigravity)
    except UsageError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    json.dump(document, sys.stdout, indent=None if args.compact else 2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
